# Askwell environment variables.
#
# Copy this file to `.env` and fill in the values for the environment you run.
# `.env` is never committed. Every variable below is listed in docs/project.md §11.
#
# Public variables (NEXT_PUBLIC_*) are shipped to the browser. That is by design
# for the Supabase publishable key: Postgres RLS is the boundary.

# --- Supabase -------------------------------------------------------------
# Dev project in local development and on Vercel previews, prod project in production.
# Used by the client and by the server.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key. Public by design: RLS is the boundary.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Acts as service_role and skips RLS.
# Read only by apps/web/lib/supabase/service.ts.
SUPABASE_SECRET_KEY=

# --- Clerk ----------------------------------------------------------------
# Publishable key for the sign in / sign up UI.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Server only. Sessions, middleware, Clerk Billing.
CLERK_SECRET_KEY=
# Server only. Verifies the signature of POST /api/clerk/webhook.
CLERK_WEBHOOK_SIGNING_SECRET=

# --- OpenAI ---------------------------------------------------------------
# Server only. Chat model and text-embedding-3-small embeddings.
OPENAI_API_KEY=

# --- Arcjet ---------------------------------------------------------------
# Server only. Rate limiting and prompt injection checks on public widget routes.
ARCJET_KEY=

# --- PostHog --------------------------------------------------------------
# Public project key and host. Read at request time by GET /api/posthog-config.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- App ------------------------------------------------------------------
# Public URL of this deployment, e.g. https://askwell.vercel.app.
# Optional, and the server's fallback for the install snippet. Without it the
# snippet names the origin the page is served from, and the prerendered HTML
# carries https://your-app.example.
NEXT_PUBLIC_APP_URL=
# Server only, read at request time. Public key of the project that runs the
# widget on the landing page. It is a public key, but it is per environment.
LANDING_WIDGET_KEY=

# --- Local tooling --------------------------------------------------------
# Not app variables. Only needed to run `pnpm db:types` (the Supabase CLI).
# A scoped personal access token: https://supabase.com/docs/guides/platform/access-tokens
SUPABASE_ACCESS_TOKEN=
# The project ref the CLI generates the types from.
SUPABASE_PROJECT_ID=
